<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.mainuan.grubeditor</id>
  <pkgname>mainuan-grub-editor</pkgname>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <project_group>org.mainuanlinux</project_group>
  <name>Mainuan GRUB Editor</name>
  <summary>Advanced editor for the GRUB bootloader configuration</summary>
  <description>
    <p>Mainuan GRUB Editor is a comprehensive graphical tool for configuring and customizing the GRUB2 bootloader. It provides an intuitive interface for managing boot settings, themes, fonts and custom entries, and follows the language chosen in KDE Plasma.</p>
    <p>Key Features:</p>
    <ul>
      <li>Available in more than 30 languages</li>
      <li>Intuitive GTK3 interface with keyboard shortcuts</li>
      <li>Theme management and installation</li>
      <li>Custom font conversion and application</li>
      <li>Background image configuration</li>
      <li>Custom boot entry management</li>
      <li>Advanced kernel parameter configuration</li>
      <li>Automatic backup and restore functionality</li>
      <li>Safe update-grub integration</li>
      <li>Multi-OS detection support</li>
    </ul>
  </description>
  <categories>
    <category>System</category>
    <category>Settings</category>
    <category>Utility</category>
  </categories>
  <requires>
    <display_length compare="ge">800</display_length>
    <internet>offline-only</internet>
    <memory compare="ge">256</memory>
  </requires>
  <keywords>
    <keyword translate="no">grub</keyword>
    <keyword>bootloader</keyword>
    <keyword>boot</keyword>
    <keyword>system</keyword>
    <keyword>configure</keyword>
    <keyword>settings</keyword>
    <keyword>customize</keyword>
    <keyword>theme</keyword>
    <keyword translate="no">mainuan</keyword>
  </keywords>
  <translation type="gettext">mainuan-grub-editor</translation>
  <launchable type="desktop-id">org.mainuan.grubeditor.desktop</launchable>
  <icon type="stock">org.mainuan.grubeditor</icon>
  <icon type="remote" width="128" height="128">
    <url>https://raw.githubusercontent.com/MainuanLinux/tyron/main/media/mainuan-grub-editor/icons/org.mainuan.grubeditor.png</url>
  </icon>
  <screenshots>
    <screenshot type="default">
      <caption>General configuration</caption>
      <image>https://raw.githubusercontent.com/MainuanLinux/tyron/main/media/mainuan-grub-editor/screenshots/screenshot1.png</image>
    </screenshot>

  <provides>
    <binary>mainuan-grub-editor</binary>
    <size type="download">1203488</size>
    <size type="installed">1631961</size>
  </provides>
  <releases>
    <release version="2.1.0" date="2026-11-17">
      <description translate="no">
        <p>Interface and AppStream metadata translated into 33 languages, following the language chosen in KDE Plasma. Accent colour changed to the blue of the Mainuan logo. A theme archive with theme.txt at its top is installed under its own name, and reinstalling a theme updates it instead of nesting a second copy. Debian packaging built and tested in continuous integration.</p>
      </description>
    </release>
    <release version="2.0.2-8" date="2026-08-01">
      <description translate="no">
        <p>New "Default Boot Mode" selector lets you choose between a fixed entry, the last installed kernel or the last booted kernel. Applying changes in General settings no longer pins the boot entry to the current kernel, which prevented newly installed kernels from ever being booted.</p>
      </description>
    </release>
    <release version="2.0.2-7" date="2026-07-29">
      <description translate="no">
        <p>Screen resolution is no longer saved using its translated label, custom boot entries can now be enabled, disabled and deleted, and the launcher wrapper registers the window under the same identifier as the desktop file.</p>
      </description>
    </release>
    <release version="2.0.2-6" date="2026-07-23">
      <description translate="no">
        <p>Boot Entries tab now works for real: memtest entries can be disabled or removed, custom entries can be added, and duplicate/mislabeled entries were fixed.</p>
      </description>
    </release>
    <release version="2.0.2-5" date="2026-07-07">
      <description translate="no">
        <p>Build dependency python3-all replaced with python3.</p>
      </description>
    </release>
    <release version="2.0.2-4" date="2026-05-22">
      <description translate="no">
        <p>Aligned Tyson legacy 1.x release timeline to correct July 2025 timestamps and cleaned up obsolete metadata tags in metainfo.xml.</p>
      </description>
    </release>
    <release version="2.0.2-3" date="2026-05-18">
      <description translate="no">
        <p>Historical correction of Tyron legacy versioning: the August 2025 package mislabelled as 1.0.4 is now correctly documented as 1.0.9; the original Tyron 1.0.4 from May 2025 has been restored to the changelog.</p>
        <p>Historical correction of Tyron legacy versioning: the August 2025 package mislabelled as 1.0.4 is now correctly documented as 1.0.9; the original Tyron 1.0.4 from May 2025 has been restored to the changelog.</p>
      </description>
    </release>
    <release version="2.0.2-2" date="2026-04-30">
      <description translate="no">
        <p>Simplified the footer UI text to match the modern Mainuan standard layout.</p>
        <p>Simplified the footer UI text to match the modern Mainuan standard layout.</p>
      </description>
    </release>
    <release version="2.0.2-1" date="2026-03-21">
      <description translate="no">
        <p>About dialog, F1 shortcut, CSS architecture refactor, icon renaming and minor fixes.</p>
        <ul>
          <li>F1 shortcut and GNOME menu About action open the About dialog</li>
          <li>Ctrl+Shift+Tab to navigate to previous tab</li>
          <li>Notebook tab labels no longer appear orange in inactive tabs</li>
          <li>CSS split into base.css (structural) and dark/light.css (color variables only)</li>
          <li>Icon files renamed from com.mainuan to org.mainuan for naming consistency</li>
        </ul>
      </description>
    </release>
    <release version="2.0.2" date="2026-03-11">
      <description translate="no">
        <p>Support for hierarchical submenus, option to enable/disable them (GRUB_DISABLE_SUBMENU), silent update on startup and visual optimizations.</p>
        <ul>
          <li>Full parsing of GRUB submenus</li>
          <li>Option to enable/disable submenus (GRUB_DISABLE_SUBMENU)</li>
          <li>Silent update-grub on application launch</li>
          <li>Compact UI for boot entries table</li>
          <li>Hierarchical path display in selectors</li>
        </ul>
      </description>
    </release>
    <release version="2.0.1" date="2026-03-07">
      <description translate="no">
        <p>Fixes for GRUB boot failures, cache conflicts, and UX improvements for timeout settings.</p>
        <ul>
          <li>
            <em>Robust Theme Management</em>: Reliably disables Debian and Mainuan script defaults.</li>
          <li>
            <em>Cache Cleanup</em>: Prevents "invalid argument" crashes deleting stale `.background_cache` files.</li>
          <li>
            <em>Smart UI</em>: Auto-disables "Show boot menu" when Timeout is 0.</li>
        </ul>
      </description>
    </release>
    <release version="2.0.0" date="2026-01-10">
      <description translate="no">
        <p>Major Release - Complete Rewrite. Complete Internationalization (8 languages). Smart theme detection, GRUB theme manager, new resolutions, refined UI and improved desktop detection.</p>
        <p>Major Release - Complete Rewrite. Complete Internationalization (8 languages). Smart theme detection, GRUB theme manager, new resolutions, refined UI and improved desktop detection.</p>
        <ul>
          <li>Smart light/dark theme detection (GNOME, KDE, XFCE)</li>
          <li>Improved desktop &amp; environment detection</li>
          <li>Refined UI layout with compact view</li>
          <li>GRUB theme installer and remover</li>
          <li>Expanded resolution support (16:9, 16:10, 4:3, 4K)</li>
          <li>UUID control option</li>
        </ul>
      </description>
    </release>
  </releases>

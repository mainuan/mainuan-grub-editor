#: ui/views/boot_entries_view.py:268
msgid ""
"Write the raw GRUB menuentry block (this is appended to /etc/grub.d/"
"40_custom):"
msgstr "Viết khối menuentry GRUB thô (sẽ được nối vào /etc/grub.d/40_custom):"

#: ui/views/boot_entries_view.py:300
